const norm=s=>String(s??'').toLowerCase().replace(/ё/g,'е').trim();
const icon=n=>`<svg viewBox="0 0 24 24" aria-hidden="true">${ICONS[n]||ICONS.flag}</svg>`;
const num=(n,a,b,c)=>n%10===1&&n%100!==11?a:n%10>=2&&n%10<=4&&(n%100<12||n%100>14)?b:c;
const initials=n=>n.split(' ')[0][0]+(n.match(/\s(\S)/)?.[1]||'');
const avatar=id=>`<span class="avatar" style="--avatar-bg:${COLORS[id][0]};--avatar-ink:${COLORS[id][1]}">${esc(initials(DATA.leaders[id].name))}</span>`;
const chip=(t,agent=false)=>`<span class="team-chip${agent?' agent-chip':''}">${esc(t)}</span>`;
const inactive=g=>g.status==='outOfScope';
const isWorking=g=>!['monitor','removed','outOfScope'].includes(g.status);
const entries=id=>DATA.leaders[id].assignments.map(a=>({a,g:GOALS.get(a.goalId)})).filter(({g})=>g);
const workEntries=id=>entries(id).filter(({g})=>isWorking(g));
const effective=({a,g})=>({...g,...Object.fromEntries(['title','target','summary','actions','metric'].filter(k=>a[k]!==undefined).map(k=>[k,a[k]]))});
const participants=(id,a)=>a.agents?.length?a.agents:(a.allProducts?DATA.leaders[id].teams:a.teams);
const goalCode=g=>g.id.startsWith('LOCAL_')?'':g.id;
const footer=()=>`<footer class="page-footer"><span>Карта целей · II полугодие 2026</span><button data-help>Как пользоваться ↗</button></footer>`;
const statusBadge=g=>g.status==='monitor'?'<span class="status-badge monitor">Мониторинг</span>':inactive(g)?'<span class="status-badge outOfScope">Вне текущего скоупа</span>':['methodPending','clarify'].includes(g.status)?'<span class="status-badge methodPending">Методика и параметры в работе</span>':'';
const resources=g=>(g.links||[]).filter(l=>/^https:\/\//.test(l.url)).map(l=>`<a class="resource-link" href="${esc(l.url)}" target="_blank" rel="noopener noreferrer">${icon(l.kind==='method'?'book':'chart')}${esc(l.label)}${icon('external')}</a>`).join('');
const curatorLine=g=>(g.curators||[]).length?`<p class="goal-curator"><span>${g.curators.length>1?'Кураторы УОР':'Куратор УОР'}</span><strong>${g.curators.map(esc).join('; ')}</strong></p>`:'';
let currentLeader=null,currentPage='home',state={},lastModalFocus=null;
const freshState=()=>({query:'',category:'all',status:'current',team:'all'});

function mountNavigation(){
 $('#leader-nav').innerHTML=ORDER.map(id=>`<a href="#/leader/${id}" data-leader-nav="${id}"><span class="nav-avatar">${esc(initials(DATA.leaders[id].name))}</span>${esc(DATA.leaders[id].name)}</a>`).join('');
 document.querySelectorAll('[data-icon]').forEach(el=>el.innerHTML=icon(el.dataset.icon));
}
function renderHome(){
 currentLeader=null;currentPage='home';$('#breadcrumb-current').textContent='Общая сводка';document.title='Карта целей · ИТ-кластеры · 2026';
 const working=DATA.goals.filter(isWorking).length,monitor=DATA.goals.filter(g=>g.status==='monitor').length;
 $('#main').innerHTML=`<section class="hero"><div><div class="eyebrow">Цели ИТ-лидеров · 2H 2026</div><h1>Одна карта.<br><span>Все цели кластера.</span></h1><p>Кто отвечает, какой результат нужен и какие участники задействованы. Выберите лидера или откройте весь перечень целей и ответственных.</p><a class="director-link" href="#/goals">Все цели и ответственные ${icon('arrow')}</a></div><div class="hero-art" aria-hidden="true"><span class="orbit"></span><span class="orbit-line"></span><span class="art-center">${icon('layers')}</span><span class="art-node n1">01</span><span class="art-node n2">08</span><span class="art-node n3">26</span><span class="art-node n4">↗</span></div></section>
 <section class="stats" aria-label="Краткая сводка"><div class="stat"><strong>${String(ORDER.length).padStart(2,'0')}</strong><span>лидеров кластеров</span></div><div class="stat"><strong>${working}</strong><span>рабочих целей</span></div><div class="stat"><strong>${String(monitor).padStart(2,'0')}</strong><span>показателя в мониторинге</span></div></section>
 <section aria-labelledby="leaders-title"><div class="section-head"><div><h2 id="leaders-title">Лидеры кластеров</h2><p>Цели, действия и участники по каждому руководителю</p></div><label class="search">${icon('search')}<input id="home-search" aria-label="Найти лидера или продукт" type="search" placeholder="Лидер, АС или продукт…" autocomplete="off"></label></div><div class="leader-grid" id="leader-grid"></div></section>
 <aside class="registry-promo"><div><h2>С кого спросить за цель</h2><p>Полный перечень целей и все назначенные лидеры на одной странице.</p></div><a class="director-link" href="#/goals">Открыть перечень ${icon('arrow')}</a></aside>
 <section class="home-directions"><div class="section-head"><div><h2>Четыре направления работы</h2><p>От результата — к конкретным действиям</p></div></div><div class="direction-grid"><div class="direction-tile">${icon('code')}<strong>Производственный процесс</strong><p>AI-навыки, инструменты, качество, производительность и сроки вывода изменений.</p></div><div class="direction-tile">${icon('database')}<strong>Данные</strong><p>Контракты, качество, владельцы данных и сроки загрузки в КАП.</p></div><div class="direction-tile">${icon('layers')}<strong>Цифровая архитектура</strong><p>Цифровой двойник, API, доступы ИИ-агентов и зрелость.</p></div><div class="direction-tile">${icon('shield')}<strong>Защита и риски</strong><p>ИТЗ, поручения инициативы «Метла» и годовой мониторинг ИЗТР.</p></div></div></section>${footer()}`;
 renderLeaderGrid('');$('#home-search').addEventListener('input',e=>renderLeaderGrid(e.target.value));
}
function renderLeaderGrid(query){
 const ids=ORDER.filter(id=>norm(DATA.leaders[id].name+' '+DATA.leaders[id].teams.join(' ')).includes(norm(query)));
 $('#leader-grid').innerHTML=ids.length?ids.map(id=>{const l=DATA.leaders[id],n=workEntries(id).length;return `<a class="leader-card" href="#/leader/${id}" aria-label="Открыть цели: ${esc(l.name)}"><div class="leader-card-top">${avatar(id)}<div><h3>${esc(l.name)}</h3><small>ИТ-лидер кластера</small></div></div><div class="card-teams">${l.teams.slice(0,4).map(t=>chip(t)).join('')}${l.teams.length>4?'<span class="team-chip">Все продукты — в карте лидера</span>':''}</div><div class="leader-card-bottom"><strong>${n} ${num(n,'рабочая цель','рабочие цели','рабочих целей')}</strong><span class="leader-card-cta">Открыть карту ${icon('arrow')}</span></div></a>`}).join(''):`<div class="empty" style="grid-column:1/-1"><strong>Ничего не найдено</strong><p>Попробуйте фамилию или другое название продукта.</p></div>`;
}
function statusOptions(){return '<option value="current">Все цели</option><option value="work">Рабочие цели</option><option value="monitor">Мониторинг</option><option value="outOfScope">Вне текущего скоупа</option>'}
function renderLeader(id){
 currentLeader=id;currentPage='leader';state=freshState();const l=DATA.leaders[id],all=entries(id),work=workEntries(id);
 $('#breadcrumb-current').textContent=l.name;document.title=`${l.name} · Цели кластера · 2026`;
 const filterTeams=[...new Set([...l.teams,...all.filter(({a})=>!a.agents?.length).flatMap(({a})=>participants(id,a))])];
 $('#main').innerHTML=`<a class="back-link" href="#/">${icon('back')}К общей сводке</a><section class="leader-heading">${avatar(id)}<div><div class="eyebrow">Персональная карта целей</div><h1>${esc(l.name)}</h1><p>ИТ-лидер кластера · II полугодие 2026</p></div><div class="leader-kpis"><div><b>${work.length}</b><small>рабочих целей</small></div><div><b>${all.filter(({g})=>g.status==='monitor').length}</b><small>мониторинг</small></div></div></section>
 <section class="team-panel" aria-label="Продукты и АС лидера"><span class="micro-label">АС / ФП / продукты кластера</span><div class="chips">${l.teams.map(t=>chip(t)).join('')}</div></section>
 <div class="section-head"><div><h2>Что нужно сделать</h2><p>Результат → действия → участники → контроль</p></div><a class="text-btn" href="#/goals">Все цели и ответственные ↗</a></div>
 <div class="goal-controls"><label class="search">${icon('search')}<input id="goal-search" type="search" aria-label="Поиск по целям" placeholder="Цель, показатель, участник или агент…" autocomplete="off"></label><select id="status-filter" aria-label="Режим целей">${statusOptions()}</select><select id="team-filter" aria-label="Фильтр по участнику"><option value="all">Все участники</option>${filterTeams.map(t=>`<option value="${esc(t)}">${esc(t)}</option>`).join('')}${all.some(({a})=>a.agents?.length)?'<option value="__agents">ИИ-агенты</option>':''}</select></div>
 <div class="category-tabs" id="category-tabs" aria-label="Направления целей"></div><div class="result-line"><span id="result-count" role="status" aria-live="polite"></span><button id="reset-filters" hidden>Сбросить фильтры</button></div><div class="goals" id="goals"></div><p class="helper-line">В карточках указаны целевые значения. Актуальные результаты и методики открываются по ссылкам контроля. ИИ-агенты перечислены внутри соответствующей цели.</p>${footer()}`;
 bindControls(renderGoals);renderGoals();
}
function modeMatch(g){return state.status==='work'?isWorking(g):state.status==='monitor'?g.status==='monitor':state.status==='outOfScope'?inactive(g):true}
function baseMatch({a,g}){
 if(!modeMatch(g))return false;
 const p=participants(currentLeader,a),v=effective({a,g});
 if(state.team==='__agents'&&!a.agents?.length)return false;
 if(state.team!=='all'&&state.team!=='__agents'&&(!p.includes(state.team)||a.agents?.length))return false;
 return !state.query||norm([g.id,v.title,v.target,v.summary,...(g.curators||[]),...v.actions,...p].join(' ')).includes(norm(state.query));
}
function renderTabs(base,render){
 const cats=['all',...Object.keys(CATEGORIES).filter(k=>base.some(({g})=>g.category===k)||state.category===k)];
 $('#category-tabs').innerHTML=cats.map(k=>`<button class="filter-tab ${state.category===k?'active':''}" data-category="${k}" aria-pressed="${state.category===k}">${k==='all'?'Все направления':CATEGORIES[k].name}<span>${k==='all'?base.length:base.filter(({g})=>g.category===k).length}</span></button>`).join('');
 $('#category-tabs').querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{state.category=b.dataset.category;render()}));
 $('#reset-filters').hidden=!(state.query||state.category!=='all'||state.status!=='current'||state.team!=='all');
}
function bindControls(render){
 $('#goal-search').addEventListener('input',e=>{state.query=e.target.value;render()});$('#status-filter').addEventListener('change',e=>{state.status=e.target.value;render()});
 $('#team-filter')?.addEventListener('change',e=>{state.team=e.target.value;render()});
 $('#reset-filters').addEventListener('click',()=>{state=freshState();$('#goal-search').value='';$('#status-filter').value='current';if($('#team-filter'))$('#team-filter').value='all';render()});
}
function renderGoals(){
 const base=entries(currentLeader).filter(baseMatch),visible=base.filter(({g})=>state.category==='all'||g.category===state.category);
 renderTabs(base,renderGoals);$('#result-count').textContent=`${visible.length} ${num(visible.length,'цель','цели','целей')}`;
 $('#goals').innerHTML=visible.length?visible.map(renderGoal).join(''):'<div class="empty"><strong>По этим фильтрам целей нет</strong><p>Измените направление, участника или режим.</p></div>';
}
function renderGoal(entry){
 const {a,g}=entry,v=effective(entry),people=participants(currentLeader,a),agents=!!a.agents?.length;
 const m=g.id==='AR26.1'&&a.target?['2 метрики','описание API / доступы']:(METRICS[g.id]||[g.metric,'целевой результат']);
 const links=resources(g),scope=inactive(g)?`<p class="scope-note conditional">${esc(g.outOfScopeReason||g.summary)}</p>`:people.length?`<div class="chips">${people.map(t=>chip(t,agents)).join('')}</div>`:'<p class="scope-note conditional">Участие организуется на уровне кластера.</p>';
 return `<article class="goal ${inactive(g)?'inactive-goal':''}" id="goal-${esc(g.id)}"><div class="goal-top"><div><div class="goal-meta">${goalCode(g)?`<span class="goal-id">${esc(goalCode(g))}</span>`:''}<span class="category-badge">${esc(CATEGORIES[g.category].long)}</span>${statusBadge(g)}</div><h2>${esc(v.title)}</h2><p class="goal-summary">${esc(v.summary)}</p>${curatorLine(g)}</div><div class="metric"><b>${esc(m[0])}</b><span>${esc(m[1])}</span></div></div>
 <div class="goal-body"><div class="target"><span class="micro-label">${g.id==='IZT26'?'Годовой показатель':'Какой результат нужен'}</span>${esc(v.target)}</div><div class="actions"><span class="micro-label">${g.id==='LOCAL_LT35'?'Что сделать':'Что организовать'}</span>${v.actions.length?`<ol>${v.actions.map(t=>`<li>${esc(t)}</li>`).join('')}</ol>`:`<p>${esc(v.summary)}</p>`}</div></div><div class="scope"><div class="scope-head"><span class="micro-label">${inactive(g)?'Применимость':agents?'ИИ-агенты под управлением лидера':'Участники под управлением лидера'}</span><span class="scope-kind">${inactive(g)?'Запуск при появлении новых АС':agents?'Целевой список агентов':a.allProducts?'Все продукты кластера':''}</span></div>${scope}</div>${links?`<div class="goal-bottom"><div class="goal-links">${links}</div></div>`:''}</article>`;
}
function ownerIds(g){return inactive(g)?[]:ORDER.filter(id=>DATA.leaders[id].assignments.some(a=>a.goalId===g.id&&a.active!==false))}
function renderRegistry(){
 currentLeader=null;currentPage='registry';state=freshState();$('#breadcrumb-current').textContent='Цели и ответственные';document.title='Цели и ответственные · Карта целей · 2026';
 $('#main').innerHTML=`<section class="registry-intro"><div class="eyebrow">Общая ответственность · 2H 2026</div><h1>Цели и ответственные</h1><p>Полный перечень целей и все назначенные лидеры. Нажмите фамилию, чтобы открыть эту цель в карте руководителя.</p></section><div class="goal-controls catalog-toolbar"><label class="search">${icon('search')}<input id="goal-search" type="search" aria-label="Найти цель или ответственного" placeholder="Цель, показатель или фамилия…" autocomplete="off"></label><select id="status-filter" aria-label="Режим целей">${statusOptions()}</select></div><div class="category-tabs" id="category-tabs" aria-label="Направления целей"></div><div class="result-line"><span id="result-count" role="status" aria-live="polite"></span><button id="reset-filters" hidden>Сбросить фильтры</button></div><div id="registry-results"></div>${footer()}`;
 bindControls(renderRegistryRows);renderRegistryRows();
}
function renderRegistryRows(){
 const base=DATA.goals.filter(g=>modeMatch(g)&&(!state.query||norm([g.id,g.title,g.target,g.summary,...(g.curators||[]),...ownerIds(g).map(id=>DATA.leaders[id].name)].join(' ')).includes(norm(state.query)))).map(g=>({g}));
 const visible=base.filter(({g})=>state.category==='all'||g.category===state.category);renderTabs(base,renderRegistryRows);
 $('#result-count').textContent=`${visible.length} ${num(visible.length,'цель','цели','целей')} · ${ORDER.length} лидеров кластеров`;
 $('#registry-results').innerHTML=visible.length?Object.keys(CATEGORIES).filter(cat=>visible.some(({g})=>g.category===cat)).map(cat=>`<section class="registry-category"><h2>${esc(CATEGORIES[cat].name)}</h2><table class="registry-table"><thead><tr><th class="registry-code">Код</th><th class="registry-goal">Цель и контроль</th><th class="registry-owners">Ответственные лидеры</th></tr></thead><tbody>${visible.filter(({g})=>g.category===cat).map(({g})=>{const owners=ownerIds(g);return `<tr data-registry-goal="${esc(g.id)}" class="${inactive(g)?'inactive-goal':''}"><td class="registry-code">${goalCode(g)?esc(goalCode(g)):'—'}</td><td class="registry-goal"><div class="goal-meta">${statusBadge(g)}</div><h3 class="registry-title">${esc(g.title)}</h3>${curatorLine(g)}<p class="registry-target">${esc(inactive(g)?g.outOfScopeReason:g.target)}</p>${g.id==='AR26.1'?'<p class="registry-caption">Состав требований применяется по карте каждого лидера.</p>':''}<div class="goal-links">${resources(g)}</div></td><td class="registry-owners"><div class="owner-links">${owners.length?owners.map(id=>`<a class="owner-chip" href="#/leader/${id}?goal=${encodeURIComponent(g.id)}">${esc(DATA.leaders[id].name)}</a>`).join(''):'<span class="registry-caption">Нет действующих назначений</span>'}</div></td></tr>`}).join('')}</tbody></table></section>`).join(''):'<div class="empty"><strong>Цели не найдены</strong><p>Измените поиск или фильтры.</p></div>';
}
function helpContent(){return `<section class="help-section"><h3>Общая сводка</h3><p>Выберите лидера, чтобы открыть его цели, действия, продукты и АС. Поиск на главной находит руководителя по фамилии или продукту.</p></section><section class="help-section"><h3>Цели и ответственные</h3><p>Здесь собраны все цели и назначенные лидеры. Поиск работает по названию цели, показателю, фамилии лидера или куратора УОР. Куратор указан под описанием цели, ответственные лидеры — в отдельной колонке. Фамилия в строке открывает нужную цель в карте руководителя.</p></section><section class="help-section"><h3>Карта руководителя</h3><p>Каждая карточка показывает требуемый результат, действия и участников. Фильтры помогают выбрать направление, продукт, мониторинг или цели вне текущего скоупа. Имена ИИ-агентов перечислены в соответствующей цели и доступны через поиск.</p></section><section class="help-section"><h3>Контроль выполнения</h3><p>Числа в карточках — целевые значения. Текущее выполнение и методики открываются по кнопкам ссылок. Для корпоративных страниц нужен соответствующий доступ.</p></section><section class="help-section"><h3>Мониторинг и применимость</h3><p>Годовой мониторинг выделен отдельно. Для DGBD текущие АС находятся вне скоупа: выполнение начнётся при появлении новых АС. Рабочие счетчики не включают цели мониторинга и цели вне скоупа.</p></section><section class="help-section"><h3>Поиск и печать</h3><p>Нажмите «Сбросить фильтры», чтобы вернуться ко всему списку. Кнопка «Печать» печатает текущую страницу с выбранными фильтрами. Карта работает одним HTML-файлом без установки.</p></section>`}
function openHelp(trigger){lastModalFocus=trigger||document.activeElement;$('#help-content').innerHTML=helpContent();$('#help-overlay').hidden=false;document.body.style.overflow='hidden';$('#close-help').focus()}
function closeHelp(){if($('#help-overlay').hidden)return;$('#help-overlay').hidden=true;document.body.style.overflow='';lastModalFocus?.focus()}
function closeMenu(){$('#rail').classList.remove('open');$('#mobile-shade').classList.remove('open');$('#mobile-menu').setAttribute('aria-expanded','false')}
function route(){
 const hash=location.hash.slice(1),[path,query='']=hash.split('?'),match=path.match(/^\/leader\/([a-z]+)$/),id=match?.[1],goal=new URLSearchParams(query).get('goal');
 if(id&&DATA.leaders[id])renderLeader(id);else if(path==='/goals')renderRegistry();else renderHome();
 for(const [selector,active] of [['#nav-overview',currentPage==='home'],['#nav-goals',currentPage==='registry']]){const el=$(selector);el.classList.toggle('active',active);if(active)el.setAttribute('aria-current','page');else el.removeAttribute('aria-current')}
 document.querySelectorAll('[data-leader-nav]').forEach(el=>{const active=el.dataset.leaderNav===currentLeader;el.classList.toggle('active',active);if(active)el.setAttribute('aria-current','page');else el.removeAttribute('aria-current')});closeMenu();window.scrollTo(0,0);
 if(goal&&GOALS.has(goal))document.getElementById('goal-'+goal)?.scrollIntoView({block:'start'});
}
document.addEventListener('click',e=>{if(e.target.closest('.skip')){e.preventDefault();$('#main').focus();$('#main').scrollIntoView({block:'start'});return}const b=e.target.closest('[data-help]');if(b)openHelp(b)});
$('#close-help').addEventListener('click',closeHelp);$('#help-overlay').addEventListener('click',e=>{if(e.target===$('#help-overlay'))closeHelp()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeHelp();closeMenu()}if(e.key==='Tab'&&!$('#help-overlay').hidden){const els=[...$('#help-overlay').querySelectorAll('button,a[href],input,select,[tabindex="0"]')],first=els[0],last=els[els.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}});
$('#mobile-menu').addEventListener('click',()=>{const open=!$('#rail').classList.contains('open');$('#rail').classList.toggle('open',open);$('#mobile-shade').classList.toggle('open',open);$('#mobile-menu').setAttribute('aria-expanded',String(open))});$('#mobile-shade').addEventListener('click',closeMenu);$('#print').addEventListener('click',()=>window.print());window.addEventListener('hashchange',route);mountNavigation();route();
</script>
</body>
</html>
