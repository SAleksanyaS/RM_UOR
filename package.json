    "setup:curators:file": "tsx scripts/provision-curators-file.ts",
    "setup:workspace": "node scripts/setup-workspace.mjs",
    "export:clean": "node scripts/export-clean.mjs",
    "history:archive": "tsx scripts/archive-local-history.ts",
    "probe:bank": "tsx scripts/probes/bank-probe.ts",
    "probe:readiness": "tsx scripts/probes/check-readiness.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "9.4.0",
    "@salutejs/sdds-themes": "0.85.0",
    "@xmldom/xmldom": "0.9.12",
    "exceljs": "4.4.0",
    "fastify": "^5.6.1",
