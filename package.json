  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24.0.0",
    "npm": ">=10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:oko": "tsx scripts/oko.ts",
    "start:oko": "tsx scripts/oko.ts --serve",
